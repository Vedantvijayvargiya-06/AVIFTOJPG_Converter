# Pixora Application Configuration
# Server Port
PORT=3000

# Storage Directory for Temporary Uploads & Converted Files
STORAGE_DIR="/tmp/pixora"

# Limits Configuration
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_BATCH=20
MAX_BATCH_TOTAL_MB=150
MAX_INPUT_PIXELS=50000000

# Defaults
DEFAULT_JPEG_QUALITY=90
DEFAULT_BACKGROUND_COLOR="#FFFFFF"
RETENTION_MINUTES=30
CLEANUP_INTERVAL_SECONDS=60
CONVERSION_CONCURRENCY=2
CONVERSION_TIMEOUT_SECONDS=60
TOMBSTONE_TTL_HOURS=24

